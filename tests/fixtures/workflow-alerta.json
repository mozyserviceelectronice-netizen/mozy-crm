      "id": "d9ebec37-7794-46ca-8b00-f34530b5b001",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH ultimul_mesaj AS (\n  SELECT DISTINCT ON (m.contact_id)\n    m.id AS message_row_id,\n    m.contact_id,\n    m.directie,\n    m.tip,\n    m.mesaj,\n    m.created_at,\n    m.necesita_raspuns,\n    m.alerta_trimisa\n  FROM whatsapp.mesaje m\n  ORDER BY m.contact_id, m.created_at DESC, m.id DESC\n)\nSELECT\n  u.message_row_id,\n  u.contact_id,\n  c.nume,\n  c.telefon,\n  u.tip,\n  u.mesaj AS ultimul_mesaj,\n  u.created_at AS data_mesaj,\n  FLOOR(EXTRACT(EPOCH FROM (\n    CURRENT_TIMESTAMP - u.created_at\n  )) / 60)::integer AS minute_asteptare\nFROM ultimul_mesaj u\nJOIN whatsapp.contacte c ON c.id = u.contact_id\nWHERE u.directie = 'incoming'\n  AND u.necesita_raspuns = true\n  AND u.created_at <= CURRENT_TIMESTAMP - INTERVAL '30 minutes'\n  AND u.alerta_trimisa = false\nORDER BY u.created_at ASC;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        48,
        0
      ],
      "id": "285c8995-d77e-4ae6-a8f0-8679e2286a04",
      "name": "Get Unanswered Clients",
      "credentials": {
        "postgres": {
          "id": "7MLsduEbzQLaYaC3",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const nume = $json.nume?.trim() || 'Nume necunoscut';\nconst telefon = $json.telefon || 'Telefon necunoscut';\nconst minute = Number($json.minute_asteptare || 0);\n\nlet mesajClient = $json.ultimul_mesaj || '';\n\nif ($json.tip === 'image') {\n  try {\n    const vision = JSON.parse(mesajClient);\n\n    const identificare = [\n      vision.marca,\n      vision.model\n    ]\n      .filter(Boolean)\n      .join(' ');\n\n    mesajClient = identificare\n      ? `Imagine TV: ${identificare}`\n      : 'Clientul a trimis o imagine.';\n  } catch {\n    mesajClient = 'Clientul a trimis o imagine.';\n  }\n}\n\nconst mesajAlerta =\n`⚠️ Client fără răspuns\n\nNume: ${nume}\nTelefon: ${telefon}\n\nUltimul mesaj:\n${mesajClient}\n\nTimp de așteptare: ${minute} minute.`;\n\nreturn {\n  json: {\n    ...$json,\n    mesaj_alerta: mesajAlerta\n  }\n};"
      },
