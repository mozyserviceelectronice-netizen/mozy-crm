{
  "name": "Mozy - Program tehnician - registru separat",
  "nodes": [
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  p.id AS programare_id,\n  p.data_programare,\n  p.ora_programare,\n  p.adresa AS adresa_interventie,\n  p.defect_reclamat,\n  p.observatii,\n  p.status,\n  c.nume,\n  c.telefon,\n  p.marca,\n  p.model,\n  p.diagonala\nFROM whatsapp.programari p\nJOIN whatsapp.contacte c ON c.id = p.contact_id\nWHERE p.data_programare = CURRENT_DATE + $1\n  AND p.status = 'confirmata'\nORDER BY p.ora_programare ASC NULLS LAST;",
        "options": {
          "queryReplacement": "={{ [1] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        208,
        0
      ],
      "id": "d5b30a64-30ce-4b26-9f6c-9b79ad352d79",
      "name": "Get Program Tomorrow",
      "credentials": {
        "postgres": {
          "id": "7MLsduEbzQLaYaC3",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "let mesaj = \"📅 Program intervenții mâine\\n\\n\";\n\nfor (const item of items) {\n  const p = item.json;\n\n  mesaj += \n`🕘 ${p.ora_programare.substring(0,5)}\n\n👤 ${p.nume}\n📞 ${p.telefon}\n📍 ${p.adresa_interventie}\n\n📺 ${p.marca} ${p.model} (${p.diagonala}\")\n🔧 ${p.defect_reclamat}\n\n${p.observatii ? \"📝 \" + p.observatii : \"\"}\n\n--------------------\n\n`;\n}\n\nreturn [\n  {\n    json: {\n      mesaj\n    }\n  }\n];"
      },
