[Unit]
Description=Mozy CRM maintenance helper
After=docker.service
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/local/lib/mozy-crm-maintenance/mozy-maintenance-helper.py
Restart=on-failure
RestartSec=3
User=root
Group=root
UMask=0077
RuntimeDirectory=mozy-crm-maintenance
RuntimeDirectoryMode=0755
StateDirectory=mozy-crm-maintenance
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/mozy-crm /opt/mozy-crm-backups /run/mozy-crm-maintenance /var/lib/mozy-crm-maintenance /var/tmp

[Install]
WantedBy=multi-user.target
