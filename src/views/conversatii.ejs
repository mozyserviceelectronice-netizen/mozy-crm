
<% if (typeof readAll !== 'undefined' && readAll) { %>
  <div class="notice success">
    Toate mesajele WhatsApp au fost marcate ca citite.
  </div>
<% } %>

<% if (
  typeof organizerSaved !== 'undefined' &&
  organizerSaved
) { %>
  <div class="notice success">
    Organizarea conversației a fost actualizată în CRM.
  </div>
<% } %>

<%
const client = currentClient || null;

const conversationRows =
  Array.isArray(rows)
    ? rows
    : [];

const numeInvalide = [
  'você',
  'voce',
  'mozy service electronice'
];

function esteGrup(row) {
  if (!row) {
    return false;
  }

  const digits = String(row.telefon || '')
    .replace(/\D/g, '');

  return (
    row.tip_conversatie === 'grup' ||
    String(row.whatsapp_jid || '')
      .toLowerCase()
      .endsWith('@g.us') ||
    (
      digits.startsWith('120363') &&
      digits.length > 15
    )
  );
}

function numeAfisat(row) {
  const nume = String(row?.nume || '').trim();

  if (
    !nume ||
    numeInvalide.includes(nume.toLowerCase())
  ) {
    return 'Client fără nume';
  }

  return nume;
}

function previewMesaj(row) {
  const mesaj = String(row?.mesaj || '').trim();

  if (row?.tip === 'image') {
    return mesaj
      ? '📷 Imagine analizată'
      : '📷 Imagine primită';
  }

  return mesaj || 'Mesaj fără conținut';
}

function mesajAfisat(row) {
  const mesaj = String(row?.mesaj || '').trim();

  if (row?.tip !== 'image') {
    return mesaj || 'Mesaj fără conținut';
  }

  try {
    const vision = JSON.parse(mesaj);
    const parts = [];

    if (vision.marca) {
      parts.push(`Marcă: ${vision.marca}`);
    }

    if (vision.model) {
      parts.push(`Model: ${vision.model}`);
    }

    if (vision.serie) {
      parts.push(`Serie: ${vision.serie}`);
    }

    if (vision.cod_produs) {
      parts.push(`Cod produs: ${vision.cod_produs}`);
    }

    if (vision.diagonala) {
      parts.push(`Diagonală: ${vision.diagonala}″`);
    }

    if (vision.tip_tv) {
      parts.push(`Tip: ${vision.tip_tv}`);
    }

    if (vision.cod_placa) {
      parts.push(`Cod placă: ${vision.cod_placa}`);
    }

    if (vision.alte_coduri) {
      parts.push(`Alte coduri: ${vision.alte_coduri}`);
    }

    if (vision.observatii) {
      parts.push(`Observații: ${vision.observatii}`);
    }

    return parts.length
      ? parts.join('\n')
      : 'Imagine primită și analizată';
  } catch {
    return mesaj || 'Imagine primită';
  }
}

function dataMesaj(value) {
  return new Intl.DateTimeFormat('ro-RO', {
    dateStyle: 'short',
    timeStyle: 'short'
  }).format(new Date(value));
}

function conversatiiUrl(overrides = {}) {
  const params = new URLSearchParams();
  const nextScope =
    overrides.scope !== undefined
      ? overrides.scope
      : (scope || 'active');
  const nextLabel =
    overrides.labelId !== undefined
      ? overrides.labelId
      : (labelId || '');
  const nextList =
    overrides.listId !== undefined
      ? overrides.listId
      : (listId || '');
  const nextClient =
    overrides.clientId !== undefined
      ? overrides.clientId
      : selectedClientId;

  params.set('scope', nextScope || 'active');

  if (nextClient) {
    params.set('client', String(nextClient));
  }

  if (q) {
    params.set('q', q);
  }

  if (nextLabel) {
    params.set('label', nextLabel);
  }

  if (nextList) {
    params.set('list', String(nextList));
  }

  return `/conversatii?${params.toString()}`;
}

function rowLabels(row) {
  return Array.isArray(row?.whatsapp_labels)
    ? row.whatsapp_labels
    : [];
}

function rowCrmLists(row) {
  return Array.isArray(row?.whatsapp_crm_lists)
    ? row.whatsapp_crm_lists
    : [];
}

function profilePhotoUrl(row) {
  if (!row?.whatsapp_profile_photo_path) {
    return null;
  }

  const version = row
    .whatsapp_profile_photo_updated_at
      ? new Date(
          row.whatsapp_profile_photo_updated_at
        ).getTime()
      : 0;

  return `/conversatii/avatar/${row.client_id || row.id}?v=${version}`;
}

function localMediaAvailable(row) {
  return String(row?.media_url || '')
    .startsWith('whatsapp-media/');
}
%>

<%- include('partials/header', {
  title: 'WhatsApp — Mozy CRM',
  active
}) %>

<section class="whatsapp-page-heading whatsapp-page-heading--minimal">
  <div class="whatsapp-signature-hero">
    <div
      class="whatsapp-signature-orb"
      aria-hidden="true"
    ></div>

    <div class="whatsapp-signature-content">
      <span class="whatsapp-signature-kicker">
        Mozy CRM · WhatsApp Workspace
      </span>

      <div class="whatsapp-signature-title">
        Proudly created &amp; coded by
        <span>Andrei Mozara</span>
      </div>

      <p class="whatsapp-signature-subtitle">
        Citește istoricul și răspunde direct din CRM.
      </p>
    </div>
  </div>
</section>

<% if (sent) { %>
  <div class="notice success">
    Mesajul a fost trimis pe WhatsApp.
  </div>
<% } %>

<% if (errorCode === 'mesaj_invalid') { %>
  <div class="notice error">
    Mesajul trebuie să conțină între 1 și 4096 de caractere.
  </div>
<% } else if (errorCode === 'telefon_lipsa') { %>
  <div class="notice error">
    Clientul nu are un număr de telefon valid.
  </div>
<% } else if (errorCode === 'trimitere') { %>
  <div class="notice error">
    Mesajul nu a putut fi trimis prin Evolution API.
  </div>
<% } %>

<section
  class="whatsapp-shell"
  data-whatsapp-live
  data-latest-message-id="<%=
    typeof latestMessageId !== 'undefined'
      ? latestMessageId
      : 0
  %>"
  data-message-total="<%=
    typeof messageTotal !== 'undefined'
      ? messageTotal
      : 0
  %>"
  data-sync-revision="<%=
    typeof syncRevision !== 'undefined'
      ? syncRevision
      : 0
  %>"
>
  <aside class="whatsapp-conversation-sidebar">
    <form
      class="whatsapp-search"
      method="get"
      action="/conversatii"
    >
      <input
        type="hidden"
        name="scope"
        value="<%= scope || 'active' %>"
      >

      <% if (labelId) { %>
        <input
          type="hidden"
          name="label"
          value="<%= labelId %>"
        >
      <% } %>

      <% if (listId) { %>
        <input
          type="hidden"
          name="list"
          value="<%= listId %>"
        >
      <% } %>

      <label for="whatsapp-search-input">
        Caută conversații
      </label>

      <div class="whatsapp-search-row">
        <input
          id="whatsapp-search-input"
          name="q"
          type="search"
          value="<%= q %>"
          placeholder="Nume sau telefon"
          autocomplete="off"
        >

        <button
          class="button secondary"
          type="submit"
        >
          Caută
        </button>
      </div>
    </form>

    <div class="whatsapp-organizer-toolbar">
      <nav
        class="whatsapp-organizer-tabs"
        aria-label="Starea conversațiilor"
      >
        <a
          class="<%= scope === 'active' ? 'active' : '' %>"
          href="<%= conversatiiUrl({
            scope: 'active',
            clientId: null
          }) %>"
        >
          Active
        </a>

        <a
          class="<%= scope === 'archived' ? 'active' : '' %>"
          href="<%= conversatiiUrl({
            scope: 'archived',
            clientId: null
          }) %>"
        >
          Arhivate
        </a>

        <a
          class="<%= scope === 'all' ? 'active' : '' %>"
          href="<%= conversatiiUrl({
            scope: 'all',
            clientId: null
          }) %>"
        >
          Toate
        </a>
      </nav>

      <form
        class="whatsapp-label-filter"
        method="get"
        action="/conversatii"
      >
        <input
          type="hidden"
          name="scope"
          value="<%= scope || 'active' %>"
        >

        <% if (q) { %>
          <input
            type="hidden"
            name="q"
            value="<%= q %>"
          >
        <% } %>

        <% if (listId) { %>
          <input
            type="hidden"
            name="list"
            value="<%= listId %>"
          >
        <% } %>

        <label for="whatsapp-label-filter">
          Etichetă WhatsApp
        </label>

        <div class="whatsapp-label-filter-row">
          <select
            id="whatsapp-label-filter"
            name="label"
          >
            <option value="">
              Toate etichetele
            </option>

            <% (allLabels || []).forEach(item => { %>
              <option
                value="<%= item.label_id %>"
                <%= labelId === item.label_id
                  ? 'selected'
                  : '' %>
              >
                <%= item.name %>
              </option>
            <% }) %>
          </select>

          <button
            class="button secondary"
            type="submit"
          >
            Filtrează
          </button>
        </div>
      </form>

      <form
        class="whatsapp-label-filter whatsapp-crm-list-filter"
        method="get"
        action="/conversatii"
      >
        <input
          type="hidden"
          name="scope"
          value="<%= scope || 'active' %>"
        >

        <% if (q) { %>
          <input
            type="hidden"
            name="q"
            value="<%= q %>"
          >
        <% } %>

        <% if (labelId) { %>
          <input
            type="hidden"
            name="label"
            value="<%= labelId %>"
          >
        <% } %>

        <label for="whatsapp-crm-list-filter">
          Listă CRM
        </label>

        <div class="whatsapp-label-filter-row">
          <select
            id="whatsapp-crm-list-filter"
            name="list"
          >
            <option value="">
              Toate listele CRM
            </option>

            <% (allCrmLists || []).forEach(item => { %>
              <option
                value="<%= item.id %>"
                <%= String(listId || '') ===
                  String(item.id)
                    ? 'selected'
                    : '' %>
              >
                <%= item.name %>
                (<%= item.member_count %>)
              </option>
            <% }) %>
          </select>

          <button
            class="button secondary"
            type="submit"
          >
            Filtrează
          </button>
        </div>
      </form>
    </div>

    <div class="whatsapp-conversation-list">
      <% if (!conversationRows.length) { %>
        <div class="empty whatsapp-empty-list">
          <% if (scope === 'archived') { %>
            <strong>
              Nu ai conversații arhivate.
            </strong>

            <span>
              Conversațiile arhivate local în CRM
              vor apărea aici.
            </span>
          <% } else if (listId) { %>
            <strong>
              Lista CRM este goală.
            </strong>

            <span>
              Adaugă conversații în această listă
              din panoul conversației.
            </span>
          <% } else if (labelId) { %>
            <strong>
              Nicio conversație cu această etichetă.
            </strong>

            <span>
              Schimbă eticheta sau elimină filtrul.
            </span>
          <% } else { %>
            <strong>
              Nu există conversații.
            </strong>

            <span>
              Nu au fost găsite rezultate pentru
              filtrul curent.
            </span>
          <% } %>
        </div>
      <% } %>

      <% conversationRows.forEach(row => { %>
        <a
          class="whatsapp-conversation-item
            <%= Number(selectedClientId) === Number(row.client_id) ? 'active' : '' %>
            <%= row.necesita_raspuns ? 'needs-reply' : '' %>"
          href="<%= conversatiiUrl({
            clientId: row.client_id
          }) %>"
        >
          <div class="whatsapp-avatar">
            <% if (profilePhotoUrl(row)) { %>
              <img
                src="<%= profilePhotoUrl(row) %>"
                alt=""
                loading="lazy"
              >
            <% } else { %>
              <span>
                <%= numeAfisat(row)
                  .slice(0, 1)
                  .toUpperCase() %>
              </span>
            <% } %>
          </div>

          <div class="whatsapp-conversation-summary">
            <div class="whatsapp-conversation-topline">
              <strong><%= numeAfisat(row) %></strong>
              <% if (esteGrup(row)) { %>
                <span class="whatsapp-group-badge">
                  GRUP
                </span>
              <% } %>

              <time datetime="<%= row.created_at %>">
                <%= dataMesaj(row.created_at) %>
              </time>
            </div>

            <div class="whatsapp-conversation-phone">
              <%= esteGrup(row)
                ? 'Grup WhatsApp'
                : (row.telefon || 'Telefon indisponibil') %>
            </div>

            <p>
              <%= row.directie === 'outgoing' ? 'Tu: ' : '' %><%= previewMesaj(row).slice(0, 90) %>
            </p>

            <div class="whatsapp-conversation-badges">
              <% if (Number(row.necitite || 0) > 0) { %>
                <span class="whatsapp-unread-count">
                  <%= row.necitite %>
                </span>
              <% } %>

              <% if (row.necesita_raspuns) { %>
                <span class="badge alert">
                  Necesită răspuns
                </span>
              <% } %>

              <% if (row.client_dificil) { %>
                <span class="flag difficult">
                  Client dificil
                </span>
              <% } %>

              <% if (row.whatsapp_archived) { %>
                <span class="badge whatsapp-archived-badge">
                  Arhivată în CRM
                </span>
              <% } %>

              <% rowLabels(row).slice(0, 3).forEach(item => { %>
                <span class="whatsapp-label-chip">
                  <%= item.name %>
                </span>
              <% }) %>

              <% if (rowLabels(row).length > 3) { %>
                <span class="whatsapp-label-chip">
                  +<%= rowLabels(row).length - 3 %>
                </span>
              <% } %>

              <% rowCrmLists(row).slice(0, 2).forEach(item => { %>
                <span class="whatsapp-crm-list-chip">
                  <%= item.name %>
                </span>
              <% }) %>

              <% if (rowCrmLists(row).length > 2) { %>
                <span class="whatsapp-crm-list-chip">
                  +<%= rowCrmLists(row).length - 2 %>
                </span>
              <% } %>
            </div>
          </div>
        </a>
      <% }) %>
    </div>
  </aside>

  <section class="whatsapp-chat-panel">
    <% if (!client) { %>
      <div class="whatsapp-no-chat">
        <div class="whatsapp-no-chat-icon">💬</div>
        <h2>Selectează o conversație</h2>
        <p>
          Alege un client din lista din stânga.
        </p>
      </div>
    <% } else { %>
      <header class="whatsapp-chat-header">
          <div class="whatsapp-chat-header-main">
            <div class="whatsapp-chat-profile-avatar">
              <% if (profilePhotoUrl(client)) { %>
                <img
                  src="<%= profilePhotoUrl(client) %>"
                  alt=""
                >
              <% } else { %>
                <span>
                  <%= numeAfisat(client)
                    .slice(0, 1)
                    .toUpperCase() %>
                </span>
              <% } %>
            </div>

            <div class="whatsapp-chat-title-block">
              <h2>
                <%= numeAfisat(client) %>
                <% if (esteGrup(client)) { %>
                  <span class="whatsapp-group-badge">
                    GRUP
                  </span>
                <% } %>
              </h2>

              <p>
                <%= esteGrup(client)
                  ? 'Conversație de grup WhatsApp'
                  : (client.telefon || 'Telefon indisponibil') %>
                <% if (client.email) { %>
                  &middot; <%= client.email %>
                <% } %>
              </p>
            </div>

            <form
              class="whatsapp-client-notes whatsapp-client-notes--inline"
              method="post"
              action="/conversatii/<%= client.id %>/notite"
            >
              <input
                type="hidden"
                name="_csrf"
                value="<%= csrfToken %>"
              >

              <input
                type="hidden"
                name="q"
                value="<%= q %>"
              >

              <div class="whatsapp-inline-note-shell">
                <div class="whatsapp-inline-note-label">
                  <span class="whatsapp-inline-note-dot"></span>
                  <span>
                    <%= esteGrup(client)
                      ? 'Notiță grup'
                      : 'Notiță client' %>
                  </span>
                </div>

                <textarea
                  name="notite_whatsapp"
                  rows="1"
                  placeholder="<%= esteGrup(client)
                    ? 'Scrie aici detalii despre grup...'
                    : 'Scrie aici detalii despre client...' %>"
                ><%= client.notite_whatsapp || '' %></textarea>

                <span
                  class="whatsapp-notes-autosave-status"
                  aria-live="polite"
                ></span>
              </div>
            </form>
          </div>

          <div class="whatsapp-chat-actions">
            <form
              class="whatsapp-mark-all-read-form"
              method="post"
              action="/conversatii/marcheaza-tot-citit"
            >
              <button
                class="button secondary"
                type="submit"
              >
                <span class="whatsapp-mark-read-icon" aria-hidden="true">
                  ✓
                </span>
                <span>Marchează tot ca citit</span>
              </button>
            </form>

            <% if (!esteGrup(client) && client.whatsapp_programare_draft_id) { %>
              <a
                class="button primary"
                href="/tehnician/programari/noua?whatsapp_draft=<%= client.whatsapp_programare_draft_id %>"
              >
                Generează programare
              </a>
            <% } %>

            <% if (!esteGrup(client) && client.fisa_activa_id) { %>
              <a
                class="button secondary"
                href="/fise/<%= client.fisa_activa_id %>"
              >
                Vezi fișa existentă
              </a>
            <% } %>

            <% if (client.client_dificil) { %>
              <span class="flag difficult">
                Client dificil
              </span>
            <% } %>
          </div>
        </header>

      <section class="whatsapp-organizer-panel">
        <form
          method="post"
          action="/conversatii/<%= client.id %>/arhivare-locala"
          class="whatsapp-archive-form"
        >
          <input
            type="hidden"
            name="archived"
            value="<%= client.whatsapp_archived ? '0' : '1' %>"
          >
          <input
            type="hidden"
            name="scope"
            value="<%= scope || 'active' %>"
          >
          <input
            type="hidden"
            name="label"
            value="<%= labelId || '' %>"
          >
          <input
            type="hidden"
            name="list"
            value="<%= listId || '' %>"
          >
          <input
            type="hidden"
            name="q"
            value="<%= q || '' %>"
          >

          <button
            class="button <%= client.whatsapp_archived
              ? 'primary'
              : 'secondary' %>"
            type="submit"
          >
            <%= client.whatsapp_archived
              ? 'Reactivează în CRM'
              : 'Arhivează în CRM' %>
          </button>
        </form>

        <details class="whatsapp-label-manager">
          <summary>
            Etichete WhatsApp
            <span>
              <%= rowLabels(client).length %>
            </span>
          </summary>

          <div class="whatsapp-label-manager-body">
            <div class="whatsapp-current-labels">
              <% if (!rowLabels(client).length) { %>
                <span class="whatsapp-label-empty">
                  Nicio etichetă atribuită.
                </span>
              <% } %>

              <% rowLabels(client).forEach(item => { %>
                <form
                  method="post"
                  action="/conversatii/<%= client.id %>/eticheta-elimina"
                  class="whatsapp-label-remove-form"
                >
                  <input
                    type="hidden"
                    name="label_id"
                    value="<%= item.label_id %>"
                  >
                  <input
                    type="hidden"
                    name="scope"
                    value="<%= scope || 'active' %>"
                  >
                  <input
                    type="hidden"
                    name="label"
                    value="<%= labelId || '' %>"
                  >
                  <input
                    type="hidden"
                    name="list"
                    value="<%= listId || '' %>"
                  >
                  <input
                    type="hidden"
                    name="q"
                    value="<%= q || '' %>"
                  >

                  <button
                    type="submit"
                    class="whatsapp-label-chip whatsapp-label-chip--button"
                    title="Elimină eticheta"
                  >
                    <%= item.name %>
                    <span aria-hidden="true">×</span>
                  </button>
                </form>
              <% }) %>
            </div>

            <%
              const assignedLabelIds = new Set(
                rowLabels(client).map(item =>
                  String(item.label_id)
                )
              );
              const availableLabels = (allLabels || [])
                .filter(item =>
                  !assignedLabelIds.has(
                    String(item.label_id)
                  )
                );
            %>

            <% if (availableLabels.length) { %>
              <form
                method="post"
                action="/conversatii/<%= client.id %>/eticheta-adauga"
                class="whatsapp-label-add-form"
              >
                <input
                  type="hidden"
                  name="scope"
                  value="<%= scope || 'active' %>"
                >
                <input
                  type="hidden"
                  name="label"
                  value="<%= labelId || '' %>"
                >
                <input
                  type="hidden"
                  name="list"
                  value="<%= listId || '' %>"
                >
                <input
                  type="hidden"
                  name="q"
                  value="<%= q || '' %>"
                >

                <select
                  name="label_id"
                  required
                >
                  <option value="">
                    Alege o etichetă
                  </option>

                  <% availableLabels.forEach(item => { %>
                    <option value="<%= item.label_id %>">
                      <%= item.name %>
                    </option>
                  <% }) %>
                </select>

                <button
                  class="button secondary"
                  type="submit"
                >
                  Adaugă
                </button>
              </form>
            <% } %>
          </div>
        </details>

        <details class="whatsapp-label-manager whatsapp-crm-list-manager">
          <summary>
            Liste CRM
            <span>
              <%= rowCrmLists(client).length %>
            </span>
          </summary>

          <div class="whatsapp-label-manager-body">
            <div class="whatsapp-current-labels">
              <% if (!rowCrmLists(client).length) { %>
                <span class="whatsapp-label-empty">
                  Conversația nu este în nicio listă CRM.
                </span>
              <% } %>

              <% rowCrmLists(client).forEach(item => { %>
                <form
                  method="post"
                  action="/conversatii/<%= client.id %>/lista-elimina"
                  class="whatsapp-label-remove-form"
                >
                  <input
                    type="hidden"
                    name="list_id"
                    value="<%= item.id %>"
                  >
                  <input
                    type="hidden"
                    name="scope"
                    value="<%= scope || 'active' %>"
                  >
                  <input
                    type="hidden"
                    name="label"
                    value="<%= labelId || '' %>"
                  >
                  <input
                    type="hidden"
                    name="list"
                    value="<%= listId || '' %>"
                  >
                  <input
                    type="hidden"
                    name="q"
                    value="<%= q || '' %>"
                  >

                  <button
                    type="submit"
                    class="whatsapp-crm-list-chip whatsapp-label-chip--button"
                    title="Elimină din listă"
                  >
                    <%= item.name %>
                    <span aria-hidden="true">×</span>
                  </button>
                </form>
              <% }) %>
            </div>

            <%
              const assignedCrmListIds = new Set(
                rowCrmLists(client).map(item =>
                  String(item.id)
                )
              );

              const availableCrmLists =
                (allCrmLists || []).filter(item =>
                  !assignedCrmListIds.has(
                    String(item.id)
                  )
                );
            %>

            <% if (availableCrmLists.length) { %>
              <form
                method="post"
                action="/conversatii/<%= client.id %>/lista-adauga"
                class="whatsapp-label-add-form"
              >
                <input
                  type="hidden"
                  name="scope"
                  value="<%= scope || 'active' %>"
                >
                <input
                  type="hidden"
                  name="label"
                  value="<%= labelId || '' %>"
                >
                <input
                  type="hidden"
                  name="list"
                  value="<%= listId || '' %>"
                >
                <input
                  type="hidden"
                  name="q"
                  value="<%= q || '' %>"
                >

                <select
                  name="list_id"
                  required
                >
                  <option value="">
                    Alege o listă CRM
                  </option>

                  <% availableCrmLists.forEach(item => { %>
                    <option value="<%= item.id %>">
                      <%= item.name %>
                    </option>
                  <% }) %>
                </select>

                <button
                  class="button secondary"
                  type="submit"
                >
                  Adaugă
                </button>
              </form>
            <% } %>

            <form
              method="post"
              action="/conversatii/liste-creeaza"
              class="whatsapp-crm-list-create-form"
            >
              <input
                type="hidden"
                name="client_id"
                value="<%= client.id %>"
              >
              <input
                type="hidden"
                name="scope"
                value="<%= scope || 'active' %>"
              >
              <input
                type="hidden"
                name="label"
                value="<%= labelId || '' %>"
              >
              <input
                type="hidden"
                name="list"
                value="<%= listId || '' %>"
              >
              <input
                type="hidden"
                name="q"
                value="<%= q || '' %>"
              >

              <input
                type="text"
                name="name"
                maxlength="120"
                required
                placeholder="Nume listă nouă"
              >

              <button
                class="button secondary"
                type="submit"
              >
                Creează
              </button>
            </form>
          </div>
        </details>

        <span class="whatsapp-local-only-note">
          Arhiva și Listele CRM sunt locale.
        </span>
      </section>

      <div
        class="whatsapp-message-history"
        id="whatsapp-message-history"
      >
        <% if (!messages.length) { %>
          <p class="empty">
            Nu există mesaje salvate pentru acest client.
          </p>
        <% } %>

        <% messages.forEach(row => { %>
          <article
            class="whatsapp-message
              <%= row.directie === 'outgoing' ? 'outgoing' : 'incoming' %>"
          >
            <div class="whatsapp-message-bubble">
              <% if (row.tip === 'image') { %>
                <div class="whatsapp-message-type">
                  📷 Imagine
                </div>
              <% } %>

              <p><%= mesajAfisat(row) %></p>

              <% if (localMediaAvailable(row)) { %>
                <% const mediaHref =
                  `/conversatii/media/${row.id}`; %>

                <% if (row.tip === 'image') { %>
                  <a
                    class="whatsapp-media-preview-link"
                    href="<%= mediaHref %>"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <img
                      class="whatsapp-media-image"
                      src="<%= mediaHref %>"
                      alt="Imagine primită prin WhatsApp"
                      loading="lazy"
                    >
                  </a>
                <% } else if (row.tip === 'audio') { %>
                  <audio
                    class="whatsapp-media-audio"
                    controls
                    preload="metadata"
                    src="<%= mediaHref %>"
                  >
                    Browserul nu poate reda mesajul audio.
                  </audio>
                <% } else if (row.tip === 'video') { %>
                  <video
                    class="whatsapp-media-video"
                    controls
                    preload="metadata"
                    src="<%= mediaHref %>"
                  >
                    Browserul nu poate reda videoclipul.
                  </video>
                <% } else { %>
                  <a
                    class="whatsapp-media-link"
                    href="<%= mediaHref %>"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    📄 Deschide documentul
                  </a>
                <% } %>
              <% } else if (
                ['image', 'video', 'audio', 'document']
                  .includes(row.tip)
              ) { %>
                <div class="whatsapp-media-unavailable">
                  <strong>
                    <%= row.tip === 'image'
                      ? 'Imagine indisponibilă'
                      : 'Fișier indisponibil' %>
                  </strong>

                  <span>
                    <%= row.media_recovery_status === 'unavailable'
                      ? 'WhatsApp nu mai permite recuperarea acestui fișier vechi.'
                      : 'Recuperarea locală este în curs sau va fi reîncercată.' %>
                  </span>
                </div>
              <% } %>

              <time datetime="<%= row.created_at %>">
                <%= dataMesaj(row.created_at) %>
                &middot;
                <%= row.directie === 'outgoing' ? 'trimis' : 'primit' %>
              </time>
            </div>
          </article>
        <% }) %>
      </div>

      <form
        class="whatsapp-composer"
        method="post"
        action="/conversatii/<%= client.id %>/trimite"
      >
        <input
          type="hidden"
          name="_csrf"
          value="<%= csrfToken %>"
        >

        <input
          type="hidden"
          name="q"
          value="<%= q %>"
        >

        <label for="whatsapp-message-input">
          Mesaj către <%= numeAfisat(client) %>
        </label>

        <div class="whatsapp-attachment-controls">
          <input
            id="whatsapp-media-input"
            class="whatsapp-media-input"
            type="file"
            accept="image/jpeg,image/png,image/webp,image/gif,audio/ogg,audio/mpeg,audio/mp4,audio/wav,video/mp4,video/3gpp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/plain,application/zip"
          >

          <button
            id="whatsapp-media-button"
            class="button secondary whatsapp-attach-button"
            type="button"
          >
            📎 Atașează
          </button>

          <span
            id="whatsapp-media-status"
            class="whatsapp-media-status"
            aria-live="polite"
          ></span>
        </div>

        <div class="whatsapp-composer-row">
          <textarea
            id="whatsapp-message-input"
            name="mesaj"
            rows="3"
            maxlength="4096"
            required
            placeholder="Scrie mesajul..."
          ></textarea>

          <button
            class="button primary whatsapp-send-button"
            type="submit"
          >
            Trimite
          </button>
        </div>

        <small>
          Mesajul este trimis manual prin Evolution API.
          AI-ul nu răspunde automat.
        </small>
      </form>
    <% } %>
  </section>
</section>

<script nonce="<%= cspNonce %>">
  const messageHistory = document.getElementById(
    'whatsapp-message-history'
  );

  if (messageHistory) {
    messageHistory.scrollTop =
      messageHistory.scrollHeight;
  }
</script>

<%- include('partials/footer') %>

<% if (client) { %>
<script nonce="<%= cspNonce %>">
(() => {
  const input = document.getElementById(
    'whatsapp-media-input'
  );

  const button = document.getElementById(
    'whatsapp-media-button'
  );

  const status = document.getElementById(
    'whatsapp-media-status'
  );

  const messageInput = document.getElementById(
    'whatsapp-message-input'
  );

  const form = messageInput?.closest('form');

  const sendButton = form?.querySelector(
    '.whatsapp-send-button'
  );

  if (
    !input ||
    !button ||
    !status ||
    !form
  ) {
    return;
  }

  let sending = false;

  button.addEventListener('click', () => {
    if (!sending) {
      input.click();
    }
  });

  input.addEventListener('change', () => {
    const file = input.files?.[0];

    if (!file) {
      status.textContent = '';
      return;
    }

    const maximum = file.type.startsWith('video/')
      ? 50 * 1024 * 1024
      : file.type.startsWith('image/')
        ? 15 * 1024 * 1024
        : 25 * 1024 * 1024;

    if (file.size > maximum) {
      status.textContent =
        'Fișierul este prea mare.';

      input.value = '';
      return;
    }

    status.textContent =
      `${file.name} selectat. Apasă Trimite.`;
  });

  form.addEventListener('submit', async event => {
    const file = input.files?.[0];

    /*
     * Fără atașament, formularul trimite mesajul text
     * în modul normal.
     */
    if (!file) {
      return;
    }

    event.preventDefault();

    if (sending) {
      return;
    }

    const maximum = file.type.startsWith('video/')
      ? 50 * 1024 * 1024
      : file.type.startsWith('image/')
        ? 15 * 1024 * 1024
        : 25 * 1024 * 1024;

    if (file.size > maximum) {
      status.textContent =
        'Fișierul este prea mare.';

      return;
    }

    const csrfToken = document
      .querySelector('meta[name="csrf-token"]')
      ?.getAttribute('content') || '';

    const caption = String(
      messageInput?.value || ''
    ).trim();

    sending = true;
    button.disabled = true;
    input.disabled = true;

    if (sendButton) {
      sendButton.disabled = true;
    }

    status.textContent =
      `Se trimite ${file.name}...`;

    try {
      const response = await fetch(
        '/conversatii/<%= client.id %>/trimite-media?q=<%= encodeURIComponent(q || "") %>',
        {
          method: 'POST',
          headers: {
            'Content-Type':
              'application/octet-stream',
            'X-CSRF-Token':
              csrfToken,
            'X-Mozy-Filename':
              encodeURIComponent(file.name),
            'X-Mozy-Mimetype':
              file.type,
            'X-Mozy-Caption':
              encodeURIComponent(caption)
          },
          body: file
        }
      );

      const payload = await response.json()
        .catch(() => ({}));

      if (!response.ok || !payload.ok) {
        throw new Error(
          payload.error ||
          'Fișierul nu a putut fi trimis.'
        );
      }

      status.textContent = 'Fișier trimis.';

      input.value = '';

      if (messageInput) {
        messageInput.value = '';
      }

      window.location.href =
        payload.redirect ||
        '/conversatii?client=<%= client.id %>';
    } catch (error) {
      status.textContent =
        error?.message ||
        'Fișierul nu a putut fi trimis.';

      sending = false;
      button.disabled = false;
      input.disabled = false;

      if (sendButton) {
        sendButton.disabled = false;
      }
    }
  });
})();
</script>
<% } %>
