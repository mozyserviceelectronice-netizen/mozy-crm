<!doctype html>
<html lang="ro">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title>Etichetă <%= field.numar_receptie %></title>
  <style nonce="<%= cspNonce %>">
    *{box-sizing:border-box}
    body{margin:0;background:#ececec;font-family:Arial,sans-serif;color:#000}
    .toolbar{display:flex;gap:10px;justify-content:center;padding:16px}
    button{padding:10px 16px;border:0;border-radius:8px;background:#111;color:#fff;font-weight:700;cursor:pointer}
    .label{width:100mm;min-height:60mm;margin:0 auto;background:#fff;border:1px solid #bbb;padding:4mm;display:grid;grid-template-columns:1fr 27mm;gap:3mm}
    .content{min-width:0}.title{font-size:14pt;font-weight:800;margin-bottom:2mm}
    .row{font-size:10.5pt;margin:1.4mm 0;line-height:1.25}.defect{font-weight:700;max-height:18mm;overflow:hidden}
    .qr{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;font-size:7pt}
    .qr img{display:block;width:25mm;height:25mm}.number{font-weight:700;margin-top:1mm;overflow-wrap:anywhere}
    .test{color:#b42318;font-size:9pt;font-weight:900;margin-bottom:1.5mm}
    @page{size:100mm 60mm;margin:0}
    @media print{
      body{background:#fff}.toolbar{display:none}.label{margin:0;border:0;width:100mm;height:60mm;min-height:60mm}
    }
  </style>
  <meta name="csrf-token" content="<%= csrfToken %>">
</head>
<body>
  <div class="toolbar">
    <button type="button" data-action="print">Tipărește eticheta</button>
  </div>

  <main class="label">
    <div class="content">
      <% if (field.este_test) { %>
        <div class="test">TEST – FĂRĂ VALOARE</div>
      <% } %>
      <div class="title">RIDICAT DE PE TEREN</div>
      <div class="row">
        <strong>Data:</strong>
        <%= new Intl.DateTimeFormat('ro-RO', {
          timeZone: 'Europe/Bucharest',
          day: '2-digit',
          month: '2-digit',
          year: 'numeric'
        }).format(new Date(field.created_at)) %>
      </div>
      <div class="row">
        <strong>Telefon:</strong> <%= field.telefon %>
      </div>
      <div class="row defect">
        <strong>Defect:</strong> <%= field.defect_reclamat || '—' %>
      </div>
      <div class="row">
        <strong>Fișă:</strong> <%= field.numar_receptie %>
      </div>
    </div>

    <div class="qr">
      <img src="<%= qrDataUrl %>" alt="Cod QR fișă">
      <div class="number"><%= field.numar_receptie %></div>
    </div>
  </main>
  <script src="/app.js" defer></script>
</body>
</html>
