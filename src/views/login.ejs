<!doctype html>
<html lang="ro">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title>Autentificare — Mozy CRM</title>
  <link rel="stylesheet" href="/styles.css?v=1.8.0">
  <meta name="csrf-token" content="<%= csrfToken %>">
</head>
<body class="login-page">
  <main class="login-card">
    <div class="brand login-brand"><span class="brand-mark">M</span><span><strong>Mozy CRM</strong><small>Service Electronice</small></span></div>
    <h1>Autentificare</h1>
    <p>Acces securizat la platforma internă.</p>
    <% if (error) { %><div class="alert error"><%= error %></div><% } %>
    <form action="/login" method="post" class="stack-form">
      <input
        type="hidden"
        name="returnTo"
        value="<%= returnTo || '/' %>"
      >
      <label>Utilizator<input name="username" autocomplete="username" required autofocus></label>
      <label>Parolă<input type="password" name="password" autocomplete="current-password" required></label>
      <button class="button primary" type="submit">Intră în CRM</button>
    </form>
  </main>
  <script src="/app.js?v=1.8.0" defer></script>
</body>
</html>
